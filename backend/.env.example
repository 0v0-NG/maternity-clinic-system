# Environment
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3000

# Database Configuration
# Supported clients: sqlite3, pg
DB_CLIENT=sqlite3
DATABASE_URL=
DB_SSL=false

# Legacy Postgres individual fields (optional when DATABASE_URL is set)
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Termii SMS Gateway
SMS_API_KEY=
SMS_SENDER_ID=ANCClinic

# App Settings
CANCEL_CUTOFF_HOURS=4
WALKIN_RESERVE_PCT=0.2
REMINDER_HOURS=24,2
